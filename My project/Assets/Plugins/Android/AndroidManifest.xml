<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — Arquivo de manifest customizado do projeto LuckArkman XR.

    INSTRUÇÕES IMPORTANTES:
    1. Este arquivo SUBSTITUI o manifest gerado automaticamente pelo Unity.
    2. Para ativá-lo: Player Settings > Publishing Settings > Custom Main Manifest.
       Mova este arquivo para o caminho indicado pelo Unity após habilitar a opção.
    3. Mantenha os elementos obrigatórios do Unity (listados abaixo com comentários).

    Referência de versões Android:
      API 26 = Android 8.0 (Oreo)   — startForegroundService obrigatório
      API 28 = Android 9.0 (Pie)    — Restrições de rede em background
      API 29 = Android 10           — Restrições de localização em background
      API 33 = Android 13           — Permissões de notificação obrigatórias
      API 34 = Android 14           — Tipo de Foreground Service obrigatório
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.luckarkman.xr">

    <!-- ================================================================ -->
    <!-- PERMISSÕES DE REDE (necessárias para streaming Wi-Fi e GPS)       -->
    <!-- ================================================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wi-Fi: necessário para descoberta UDP + MJPEG streaming -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ================================================================ -->
    <!-- PERMISSÕES DE LOCALIZAÇÃO (GPS + Google Maps Navigation)          -->
    <!-- ================================================================ -->

    <!-- Localização precisa: necessária para GPS e Maps Navigation SDK -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Localização aproximada: declarada junto com FINE_LOCATION (Android 12+) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Localização em background: necessária para navegação com tela bloqueada -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ================================================================ -->
    <!-- PERMISSÕES DE CÂMERA (câmera do smartphone como fallback)         -->
    <!-- ================================================================ -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ================================================================ -->
    <!-- PERMISSÕES DE FOREGROUND SERVICE E WAKELOCK                       -->
    <!-- ================================================================ -->

    <!-- Obrigatória para chamar startForegroundService() -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Obrigatória no Android 14 (API 34) para Foreground Service com localização -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- WakeLock: mantém CPU ativa com a tela bloqueada -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ================================================================ -->
    <!-- PERMISSÕES DE NOTIFICAÇÃO (Android 13+ exige permissão explícita) -->
    <!-- ================================================================ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ================================================================ -->
    <!-- FEATURES DE HARDWARE REQUERIDAS                                    -->
    <!-- ================================================================ -->
    <uses-feature android:name="android.hardware.camera"          android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps"    android:required="false" />
    <uses-feature android:name="android.hardware.wifi"            android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/app_icon"
        android:theme="@style/UnityThemeSelector"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">
        <!--
            android:usesCleartextTraffic="true"
            Necessário para comunicação HTTP (não HTTPS) com o ESP32-CAM.
            Em produção futura, migrar para HTTPS e remover esta flag.
        -->

        <!-- ============================================================ -->
        <!-- ACTIVITY PRINCIPAL DO UNITY (OBRIGATÓRIA — NÃO REMOVER)      -->
        <!-- ============================================================ -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="false"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Metadado de orientação para Unity 6 -->
            <meta-data
                android:name="android.notch_support"
                android:value="true" />
        </activity>

        <!-- ============================================================ -->
        <!-- FOREGROUND SERVICE — ASSISTENTE MIDAS                         -->
        <!-- ============================================================ -->
        <service
            android:name="com.luckarkman.xr.MidasForegroundService"
            android:exported="false"
            android:foregroundServiceType="location">
            <!--
                android:exported="false"
                Este serviço só pode ser iniciado por este app (segurança).

                android:foregroundServiceType="location"
                Declaração obrigatória no Android 14 (API 34).
                Informa ao sistema que este serviço usa GPS em foreground.
            -->
        </service>

    </application>

</manifest>
